# -----------------
# SERVER (API) CONFIG
# -----------------
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# MongoDB Atlas Connection URI
# Replace with your MongoDB Atlas connection string:
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/madni_school?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/madni_public_school

# JWT Secret for Admin Authentication
JWT_SECRET=madni_school_production_secret_key_change_in_production_39824
JWT_EXPIRES_IN=7d

# Initial Admin User Seeding (Automatically created on startup if not present)
ADMIN_SEED_EMAIL=admin@madnipublicschool.edu.pk
ADMIN_SEED_PASSWORD=MadniAdmin2024!

# Media Storage Provider ('local' | 'cloudinary')
STORAGE_PROVIDER=local

# Cloudinary Settings (Required only if STORAGE_PROVIDER=cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email Notification Integration Point (Optional)
EMAIL_NOTIFICATIONS_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ADMIN_NOTIFICATION_EMAIL=admin@madnipublicschool.edu.pk

# -----------------
# CLIENT CONFIG
# -----------------
NEXT_PUBLIC_API_URL=http://localhost:5000
NEXT_PUBLIC_SCHOOL_PHONE=0318-9969994
NEXT_PUBLIC_GA_ID=
