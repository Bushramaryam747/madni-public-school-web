# Client Environment Variables
# In local development, the Next.js rewrite in next.config.mjs proxies /api/v1 to http://localhost:5000/api/v1
# In production, set this to your hosted backend API URL (e.g. Render, Railway)
NEXT_PUBLIC_API_URL=http://localhost:5000

# School Helpline Phone Number
NEXT_PUBLIC_SCHOOL_PHONE=0318-9969994

# Google Analytics Measurement ID (optional)
NEXT_PUBLIC_GA_ID=
