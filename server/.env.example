# Server Port & Environment
PORT=5000
NODE_ENV=development

# Client Origin (CORS)
CLIENT_URL=http://localhost:3000

# MongoDB Atlas Connection URI
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/madni_school?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/madni_public_school

# JWT Secret & Expiration
JWT_SECRET=madni_school_production_secret_key_replace_with_strong_random_hash
JWT_EXPIRES_IN=7d

# Storage Provider (options: 'local' | 'cloudinary')
STORAGE_PROVIDER=local

# Cloudinary Credentials (if STORAGE_PROVIDER=cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Initial Admin Seeding Credentials (seeded automatically on first startup)
ADMIN_SEED_EMAIL=admin@madnipublicschool.edu.pk
ADMIN_SEED_PASSWORD=MadniAdmin2024!

# Optional Email Notification (Nodemailer / Resend)
EMAIL_NOTIFICATIONS_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ADMIN_NOTIFICATION_EMAIL=admin@madnipublicschool.edu.pk
